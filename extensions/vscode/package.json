{
  "name": "bulwark-vscode",
  "displayName": "Bulwark",
  "description": "Security findings from the Bulwark CLI as native VS Code diagnostics.",
  "version": "1.0.0",
  "publisher": "bulwark-scan",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Bulwark runs a local program over the workspace and must not run in an untrusted folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "bulwark.scanWorkspace",
        "title": "Bulwark: Scan Workspace"
      },
      {
        "command": "bulwark.clearFindings",
        "title": "Bulwark: Clear Findings"
      },
      {
        "command": "bulwark.showOutput",
        "title": "Bulwark: Show Output"
      },
      {
        "command": "bulwark.scanChangedSinceBase",
        "title": "Bulwark: Scan (new since base branch)"
      }
    ],
    "configuration": {
      "title": "Bulwark",
      "properties": {
        "bulwark.cliPath": {
          "type": "string",
          "default": "bulwark",
          "scope": "machine",
          "markdownDescription": "Path to the `bulwark` command. Machine-scoped on purpose: a workspace cannot choose which program runs."
        },
        "bulwark.tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bandit",
              "semgrep",
              "gitleaks",
              "trivy",
              "osv-scanner"
            ]
          },
          "uniqueItems": true,
          "default": [
            "bandit",
            "semgrep",
            "gitleaks",
            "trivy",
            "osv-scanner"
          ],
          "description": "Which scanners to run. An empty list runs all of them."
        },
        "bulwark.minimumSeverity": {
          "type": "string",
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "default": "INFO",
          "description": "Hide findings below this severity."
        },
        "bulwark.timeoutSeconds": {
          "type": "number",
          "default": 1800,
          "minimum": 30,
          "description": "Stop a scan that runs longer than this."
        },
        "bulwark.cache": {
          "type": "boolean",
          "default": true,
          "description": "Reuse cached results for files this workspace hasn't changed since the last scan (plan §20.1), instead of rescanning the whole tree every time."
        },
        "bulwark.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Branch \"Bulwark: Scan (new since base branch)\" compares HEAD against."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out bulwark-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rago12bit/cybernatics.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/rago12bit/cybernatics#vs-code-extension-early",
  "bugs": {
    "url": "https://github.com/rago12bit/cybernatics/issues"
  },
  "keywords": [
    "security",
    "sast",
    "sca",
    "secrets",
    "bandit",
    "semgrep",
    "trivy",
    "gitleaks"
  ]
}
