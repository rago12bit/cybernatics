{
  "compilerOptions": {
    "types": ["node", "vscode"],
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "lib": ["ES2022"]
  },
  "include": ["src"]
}
