{
  "openapi": "3.1.0",
  "info": {
    "title": "Bulwark API",
    "description": "Unified security scanning: submit a scan, watch progress, read findings.",
    "version": "0.1.0"
  },
  "paths": {
    "/scans": {
      "post": {
        "summary": "Create Scan",
        "operationId": "create_scan_scans_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Scans",
        "operationId": "list_scans_scans_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScanSummary"
                  },
                  "title": "Response List Scans Scans Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scans/upload": {
      "post": {
        "summary": "Upload Scan",
        "operationId": "upload_scan_scans_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_scan_scans_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/risk/feeds": {
      "get": {
        "summary": "Risk Feeds",
        "operationId": "risk_feeds_risk_feeds_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedsStatus"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/scans/{scan_id}": {
      "get": {
        "summary": "Get Scan",
        "operationId": "get_scan_scans__scan_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scans/{scan_id}/findings": {
      "get": {
        "summary": "Get Findings",
        "operationId": "get_findings_scans__scan_id__findings_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "tool",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tool"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match on file path.",
              "title": "Path"
            },
            "description": "Substring match on file path."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(severity|path|risk)$",
              "default": "severity",
              "title": "Sort"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingsPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scans/{scan_id}/export": {
      "get": {
        "summary": "Export Scan",
        "description": "Download the whole scan (every finding, ranked) as SARIF 2.1.0, HTML, PDF or JSON.",
        "operationId": "export_scan_scans__scan_id__export_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "sarif | html | pdf | json",
              "default": "sarif",
              "title": "Format"
            },
            "description": "sarif | html | pdf | json"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_scan_scans_upload_post": {
        "properties": {
          "archive": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Archive"
          },
          "tools": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools",
            "description": "Comma-separated; default all."
          }
        },
        "type": "object",
        "required": [
          "archive"
        ],
        "title": "Body_upload_scan_scans_upload_post"
      },
      "FeedsStatus": {
        "properties": {
          "fetched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "default": true
          },
          "epss": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epss",
            "description": "FIRST.org EPSS: score date, rows."
          },
          "kev": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kev",
            "description": "CISA KEV: catalog version, entries."
          },
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Errors",
            "description": "Last download error per feed."
          }
        },
        "type": "object",
        "title": "FeedsStatus",
        "description": "State of the exploit-likelihood feeds behind risk scores. Empty until the first download."
      },
      "FindingsPage": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "title": "FindingsPage"
      },
      "GitSource": {
        "properties": {
          "type": {
            "type": "string",
            "const": "git",
            "title": "Type"
          },
          "url": {
            "type": "string",
            "maxLength": 300,
            "title": "Url",
            "examples": [
              "https://github.com/OWASP/NodeGoat"
            ]
          }
        },
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "title": "GitSource"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScanCreated": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "ScanCreated"
      },
      "ScanRequest": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/GitSource"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools",
            "description": "Defaults to all tools."
          }
        },
        "type": "object",
        "required": [
          "source"
        ],
        "title": "ScanRequest"
      },
      "ScanSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "source_label": {
            "type": "string",
            "title": "Source Label"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "unique_findings": {
            "type": "integer",
            "title": "Unique Findings"
          },
          "severity_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Severity Counts"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "source_type",
          "source_label",
          "created_at",
          "finished_at",
          "unique_findings",
          "severity_counts"
        ],
        "title": "ScanSummary"
      },
      "ScanView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "source_label": {
            "type": "string",
            "title": "Source Label"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "tool_status": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ToolStatus"
            },
            "type": "object",
            "title": "Tool Status"
          },
          "severity_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Severity Counts"
          },
          "raw_findings": {
            "type": "integer",
            "title": "Raw Findings",
            "description": "Sum of every tool's findings before correlation."
          },
          "unique_findings": {
            "type": "integer",
            "title": "Unique Findings",
            "description": "Findings after cross-tool deduplication."
          },
          "dedup_rate": {
            "type": "number",
            "title": "Dedup Rate",
            "description": "1 - unique/raw; 0 when there were no findings."
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "source_type",
          "source_label",
          "tools",
          "created_at",
          "started_at",
          "finished_at",
          "error",
          "tool_status",
          "severity_counts",
          "raw_findings",
          "unique_findings",
          "dedup_rate"
        ],
        "title": "ScanView"
      },
      "ToolStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "findings": {
            "type": "integer",
            "title": "Findings",
            "default": 0
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "raw_artifact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Artifact",
            "description": "withheld/available"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ToolStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
