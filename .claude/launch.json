{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "mkdocs",
      "runtimeArgs": ["serve", "-a", "127.0.0.1:8001"],
      "port": 8001
    }
  ]
}
