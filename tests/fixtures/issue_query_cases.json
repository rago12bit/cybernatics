{
  "about": "The Issues query language's shared cases (Week 73). core/search/language.py (tests/unit/test_issue_search.py) and web/lib/issue-query.ts (web/tests/issue-query.test.ts) must both give exactly these results. `filters` is the parsed query; `query` is it written back; `error` is the span at fault and a phrase from the message.",
  "cases": [
    {"q": "", "filters": {}, "query": ""},
    {"q": "   ", "filters": {}, "query": ""},
    {"q": "priority:P1 sla:breached project:payments-* -status:accepted",
     "filters": {"status": {"exclude": ["accepted"]}, "priority": {"include": ["P1"]}, "sla": {"include": ["breached"]}, "project": {"include": ["payments-*"]}},
     "query": "-status:accepted priority:P1 sla:breached project:payments-*"},
    {"q": "SEVERITY:High prio:p2", "filters": {"severity": {"include": ["high"]}, "priority": {"include": ["P2"]}}, "query": "severity:high priority:P2"},
    {"q": "sev:critical,high severity:high", "filters": {"severity": {"include": ["critical", "high"]}}, "query": "severity:critical,high"},
    {"q": "-severity:info,low", "filters": {"severity": {"exclude": ["info", "low"]}}, "query": "-severity:info,low"},
    {"q": "severity:high -severity:high", "filters": {"severity": {"include": ["high"], "exclude": ["high"]}}, "query": "severity:high -severity:high"},
    {"q": "project:\"acme/payments api\"", "filters": {"project": {"include": ["acme/payments api"]}}, "query": "project:\"acme/payments api\""},
    {"q": "sql injection", "filters": {"text": ["sql", "injection"]}, "query": "sql injection"},
    {"q": "\"open redirect\" Open", "filters": {"text": ["open redirect", "Open"]}, "query": "\"open redirect\" Open"},
    {"q": "sql SQL", "filters": {"text": ["sql"]}, "query": "sql"},
    {"q": "first_seen:>30d", "filters": {"first_seen": {"dates": [">30d"]}}, "query": "first_seen:>30d"},
    {"q": "last_seen:<=7d fixed:<2026-03-01", "filters": {"last_seen": {"dates": ["<=7d"]}, "fixed": {"dates": ["<2026-03-01"]}}, "query": "last_seen:<=7d fixed:<2026-03-01"},
    {"q": "first_seen:2026-01-01..2026-01-31", "filters": {"first_seen": {"dates": [">=2026-01-01", "<2026-02-01"]}}, "query": "first_seen:>=2026-01-01 first_seen:<2026-02-01"},
    {"q": "last_seen:2026-05-04", "filters": {"last_seen": {"dates": [">=2026-05-04"]}}, "query": "last_seen:>=2026-05-04"},
    {"q": "path:src/*.py category:SAST", "filters": {"path": {"include": ["src/*.py"]}, "category": {"include": ["sast"]}}, "query": "path:src/*.py category:sast"},
    {"q": "owner:me assignee:none tag:pci,\"q4 audit\"", "filters": {"assignee": {"include": ["me", "none"]}, "tag": {"include": ["pci", "q4 audit"]}}, "query": "assignee:me,none tag:pci,\"q4 audit\""},
    {"q": "state:fixed retest:requested bu:Payments source:import", "filters": {"status": {"include": ["fixed"]}, "portfolio": {"include": ["Payments"]}, "source": {"include": ["import"]}, "retest": {"include": ["requested"]}}, "query": "status:fixed portfolio:Payments source:import retest:requested"},
    {"q": "bogus:1", "error": {"start": 0, "end": 5, "contains": "no filter called"}},
    {"q": "severity:high -Prio:P9", "error": {"start": 20, "end": 22, "contains": "not a priority"}},
    {"q": "severity:", "error": {"start": 0, "end": 9, "contains": "needs a value"}},
    {"q": "\"open redirect", "error": {"start": 0, "end": 14, "contains": "never closed"}},
    {"q": "path:\"src/a b\"x", "error": {"start": 5, "end": 15, "contains": "space after the closing quote"}},
    {"q": "-injection", "error": {"start": 0, "end": 10, "contains": "cannot be excluded"}},
    {"q": "-first_seen:>3d", "error": {"start": 0, "end": 15, "contains": "opposite comparison"}},
    {"q": "severity:hi*", "error": {"start": 9, "end": 12, "contains": "not a severity"}},
    {"q": "tag:pc*", "error": {"start": 4, "end": 7, "contains": "works in project"}},
    {"q": "first_seen:yesterday", "error": {"start": 11, "end": 20, "contains": "A date is like"}},
    {"q": "first_seen:2026-02-30", "error": {"start": 11, "end": 21, "contains": "not a real date"}},
    {"q": "first_seen:>2026-01-01..2026-02-01", "error": {"start": 11, "end": 34, "contains": "two dates"}},
    {"q": "sql\"inj\"", "error": {"start": 0, "end": 4, "contains": "Put quotes around"}}
  ]
}
